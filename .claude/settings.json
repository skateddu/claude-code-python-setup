{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "fallbackModel": ["claude-sonnet-5-5", "claude-haiku-5-5"],
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv run python *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.envrc)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Read(./**/secret*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(./**/*token*)",
      "Read(~/.ssh/**)",
      "Read(./**/*id_rsa*)",
      "Read(./**/*id_ed25519*)",
      "Read(./**/*id_ecdsa*)",
      "Read(./**/*id_dsa*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "uv run --no-project python .claude/statusline.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(python *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(python3 *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(py *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(pytest *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(ruff *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(mypy *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(bandit *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(pip *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(pip3 *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(rm *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "Bash(sudo *)"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(python *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(python3 *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(py *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(pytest *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(ruff *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(mypy *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(bandit *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(pip *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-uv.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(pip3 *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(git *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(Remove-Item *)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.sh\"",
            "timeout": 10000,
            "onFailure": "block",
            "if": "PowerShell(sudo *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-lint.sh\"",
            "timeout": 30000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 180000
          }
        ]
      }
    ]
  }
}
